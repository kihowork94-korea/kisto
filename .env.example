# 최소 이거 하나는 반드시 필요합니다 (console.anthropic.com 에서 발급)
# 없으면 로그인된 Claude Code CLI(하네스)로 대체 실행됩니다
ANTHROPIC_API_KEY=

# 없으면 해당 모듈은 자동으로 Claude로 대체 실행됩니다
# 교차검증을 "다른 회사 모델"로 실증하려면 둘 중 하나는 넣어야 합니다
OPENAI_API_KEY=
GOOGLE_API_KEY=

# (선택) 모델 교체 — 비워두면 코드의 기본값을 씁니다
ANTHROPIC_MODEL=
OPENAI_MODEL=
GEMINI_MODEL=
